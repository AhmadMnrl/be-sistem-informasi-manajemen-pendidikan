generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  KEPALA_SEKOLAH
  GURU
}

enum SectionType {
  TABLE
  TEXT
  MIXED
}

enum QuestionType {
  QUESTION   // pilihan jawaban
  FREE_TEXT  // teks bebas
  PHOTO      // unggah foto
}

enum Semester {
  GANJIL
  GENAP
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reportsAuthored       Report[]   @relation("ReportTeacher")
  documentsUploaded     Document[]
  anecdotes             Anecdote[]
  questionsAuthored     Question[]
  apeUpdated            Ape[]        @relation("ApeUpdatedBy")
  apeCreated            Ape[]        @relation("ApeCreatedBy")
  activityLogs          ActivityLog[]
  createdTemplates      ReportTemplate[]
  createdStudentReports StudentReport[]
}

model Student {
  id           Int       @id @default(autoincrement())
  name         String
  identifier   String    @unique
  nisn         String?
  className    String?
  tahunAjaran  String?
  parentName   String?
  parentPhone  String?
  address      String?
  photoUrl     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  reports        Report[]
  studentReports StudentReport[]

  @@index([identifier])
}

model Report {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  photoUrl    String?
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())

  studentId Int
  student   Student   @relation(fields: [studentId], references: [id])

  teacherId Int
  teacher   User      @relation("ReportTeacher", fields: [teacherId], references: [id])
}

model Document {
  id           Int       @id @default(autoincrement())
  title        String
  category     String?
  filePath     String
  documentDate DateTime?
  uploadedAt   DateTime  @default(now())

  uploadedById Int
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
}

model Anecdote {
  id          Int       @id @default(autoincrement())
  content     String
  description String?   @db.Text
  category    String?
  date        DateTime  @default(now())
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  teacherId Int
  teacher   User      @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
}

model Question {
  id        Int       @id @default(autoincrement())
  text      String
  imageUrl  String?
  createdAt DateTime  @default(now())

  teacherId Int
  teacher   User      @relation(fields: [teacherId], references: [id])
}

model Ape {
  id         Int       @id @default(autoincrement())
  name       String
  condition  String?
  quantity   Int       @default(0)
  location   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  createdById Int?
  createdBy   User?     @relation("ApeCreatedBy", fields: [createdById], references: [id])
  updatedById Int
  updatedBy   User      @relation("ApeUpdatedBy", fields: [updatedById], references: [id])
}

model ActivityLog {
  id        Int       @id @default(autoincrement())
  action    String
  entity    String?
  entityId  Int?
  metadata  Json?
  createdAt DateTime  @default(now())

  userId Int
  user   User     @relation(fields: [userId], references: [id])
}

model ReportTemplate {
  id          Int            @id @default(autoincrement())
  title       String
  year        Int?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())

  createdById Int
  createdBy   User           @relation(fields: [createdById], references: [id])

  sections    ReportSection[]
  studentReports StudentReport[]

  @@index([isActive])
}

model ReportSection {
  id            Int            @id @default(autoincrement())
  sectionNumber Int
  order         Int?
  type          SectionType
  title         String?
  headers       String?

  templateId Int
  template   ReportTemplate @relation(fields: [templateId], references: [id])

  questions  ReportQuestion[]
}

model ReportQuestion {
  id         Int           @id @default(autoincrement())
  text       String
  order      Int?
  type       QuestionType  @default(QUESTION)

  sectionId  Int
  section    ReportSection @relation(fields: [sectionId], references: [id])

  options    ReportAnswerOption[]
  studentAnswers StudentReportAnswer[]
}

model ReportAnswerOption {
  id         Int            @id @default(autoincrement())
  label      String

  questionId Int
  question   ReportQuestion @relation(fields: [questionId], references: [id])
}

model StudentReport {
  id           Int                  @id @default(autoincrement())
  year         Int
  semester     Semester             @default(GANJIL)
  createdAt    DateTime             @default(now())

  studentId    Int
  student      Student              @relation(fields: [studentId], references: [id])

  templateId   Int
  template     ReportTemplate       @relation(fields: [templateId], references: [id])

  createdById  Int
  createdBy    User                 @relation(fields: [createdById], references: [id])

  answers      StudentReportAnswer[]
}

model StudentReportAnswer {
  id              Int           @id @default(autoincrement())
  ket             String?
  answerText      String?       // untuk FREE_TEXT
  selectedOption  String?       // untuk QUESTION
  photoUrl        String?       // untuk PHOTO
  predikat        String?       // untuk penilaian predikat 
  studentReportId Int
  studentReport   StudentReport @relation(fields: [studentReportId], references: [id])

  questionId      Int
  question        ReportQuestion @relation(fields: [questionId], references: [id])
}